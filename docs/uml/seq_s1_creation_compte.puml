@startuml
!include style.puml
hide footbox
skinparam boundaryBackgroundColor #FBEAEC
skinparam boundaryBorderColor #910014
skinparam controlBackgroundColor #FBEAEC
skinparam controlBorderColor #910014
skinparam databaseBackgroundColor #FFFFFF
autonumber
actor "Personnel\nadministratif" as A
boundary "Page Nouveau\ncompte utilisateur" as PN
control "Middleware\nJWT / rôle" as MW
control "CompteController\n/api/comptes" as C
database "utilisateurs" as TU
database "praticiens /\npersonnels" as TPP
database "jetons_securite" as TJ
participant "Service de\nmessagerie" as MSG

A -> PN : Saisit identité, e-mail, rôle,\nclinique (et spécialité)
PN -> MW : POST /api/comptes (cookie JWT)
alt Rôle différent de AGENT_ADMIN / ADMIN
  MW --> PN : 403 Accès interdit
else Rôle autorisé
  MW -> C : requête autorisée
  C -> TU : SELECT id_utilisateur WHERE email = $1
  alt E-mail existant
    C --> PN : 409 Compte déjà existant
  else E-mail libre
    C -> TU : INSERT (id_role, statut = en_attente,\nmot_de_passe_hash = NULL)
    C -> TPP : INSERT (specialite ou id_clinique)
    C -> TJ : INSERT (type = activation, expire_le = +72 h)
    C -> MSG : Lien /activation?token=…
    C --> PN : 201 Compte créé
    PN --> A : Confirmation + liste des derniers comptes
  end
end
@enduml
