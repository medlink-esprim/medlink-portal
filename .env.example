# Copier ce fichier en .env (jamais commité) puis remplir les valeurs.
# DB_PASSWORD doit être le même dans les deux lignes ci-dessous.
DB_PASSWORD=change_me
DATABASE_URL=postgres://medlink:change_me@db:5432/medlink
# Générer avec : openssl rand -hex 32
JWT_SECRET=
APP_URL=http://localhost:5173
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=MedLink <no-reply@medlink.local>
# US-43 : clé AES-256 des données médicales. Générer avec : openssl rand -base64 32
# Rotation : ajouter 2:<nouvelle clé>, passer CHIFFREMENT_CLE_ACTIVE à 2 (voir deploy/ROTATION_CLES.md)
CHIFFREMENT_CLES=1:
CHIFFREMENT_CLE_ACTIVE=1
# US-45 (production, facultatif) : avec docker-compose.vault.yml, l'API lit ses secrets dans Vault.
# VAULT_ROLE_ID est écrit par deploy/vault/initialiser.sh ; laisser vide en développement.
VAULT_ROLE_ID=
# US-49 (production) : portail ouvert de 6 h à 22 h, heure de Tunis. Laisser vide en développement.
HORAIRES_SERVICE=
